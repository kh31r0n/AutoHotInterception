<Window x:Class="AHIConfigurator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="1000" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ApplyCommand}" FontWeight="SemiBold"
                            ToolTip="Save, generate the mapping script and (re)start it">▶ Apply</Button>
                    <Button Command="{Binding StopCommand}" ToolTip="Stop the running mappings">■ Stop</Button>
                    <Button Command="{Binding ExportCommand}" ToolTip="Save an editable copy of the generated AHK script">Export .ahk...</Button>
                    <Button Command="{Binding RefreshDevicesCommand}" ToolTip="Re-scan connected keyboards and mice">Refresh devices</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding RunAtLogin}" VerticalAlignment="Center" Margin="0,0,12,0"
                              Content="Start mappings when I sign in" />
                    <Button Command="{Binding ChooseAutoHotkeyCommand}" Margin="0">AutoHotkey path...</Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding ScriptStatus}" FontWeight="SemiBold" />
            <Separator />
            <StatusBarItem Content="{Binding DriverStatus}" />
            <Separator />
            <StatusBarItem Content="{Binding AhkStatus}" />
        </StatusBar>

        <!-- Setup problems -->
        <Border DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E0C060" BorderThickness="0,0,0,1" Padding="12,8"
                Visibility="{Binding Banner, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" Foreground="#5C4400" />
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: devices + profiles -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="Devices" />
                    <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                             MouseDoubleClick="Device_DoubleClick" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" FontSize="20" Width="30"
                                               FontFamily="Segoe UI Emoji" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" FontSize="11" />
                                    </StackPanel>
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,14">
                    <Button Command="{Binding RenameDeviceCommand}">Rename...</Button>
                    <Button Command="{Binding ForgetDeviceCommand}" ToolTip="Remove a device that is no longer connected, with its mappings">Forget</Button>
                </StackPanel>

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="Profiles" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,6" FontSize="11"
                               Text="The first profile that matches the active window and maps an input wins. Default applies everywhere." />
                    <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             MouseDoubleClick="Profile_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MatchDescription}" Style="{StaticResource Hint}" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <WrapPanel Grid.Row="3" Margin="0,6,0,0">
                    <WrapPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                        </Style>
                    </WrapPanel.Resources>
                    <Button Command="{Binding AddProfileCommand}">Add...</Button>
                    <Button Command="{Binding EditProfileCommand}">Edit...</Button>
                    <Button Command="{Binding DeleteProfileCommand}">Delete</Button>
                    <Button Command="{Binding MoveProfileUpCommand}" ToolTip="Higher priority">▲</Button>
                    <Button Command="{Binding MoveProfileDownCommand}" ToolTip="Lower priority">▼</Button>
                </WrapPanel>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: mappings of the selected profile -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}">
                    <Run Text="Mappings in " /><Run Text="{Binding SelectedProfile.Name, Mode=OneWay}" />
                </TextBlock>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Command="{Binding AddMappingCommand}" FontWeight="SemiBold">Add mapping...</Button>
                    <Button Command="{Binding EditMappingCommand}">Edit...</Button>
                    <Button Command="{Binding DeleteMappingCommand}">Delete</Button>
                </StackPanel>
                <Grid>
                    <DataGrid x:Name="MappingGrid" ItemsSource="{Binding Mappings}" SelectedItem="{Binding SelectedMapping}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26"
                              MouseDoubleClick="Mapping_DoubleClick" KeyDown="MappingGrid_KeyDown"
                              CanUserReorderColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="2*" />
                            <DataGridTextColumn Header="When I press" Binding="{Binding Trigger}" Width="1.5*" />
                            <DataGridTextColumn Header="It does" Binding="{Binding Action}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"
                               TextAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Mappings.Count, Converter={StaticResource ZeroToVisible}}"
                               Text="No mappings yet.&#x0a;Click &quot;Add mapping...&quot; and press the key or button you want to change." />
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
