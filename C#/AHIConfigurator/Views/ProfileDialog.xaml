<Window x:Class="AHIConfigurator.Views.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="_Name:" Target="{Binding ElementName=NameBox}" />
            <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,2" />
            <Label Grid.Row="1" Content="_Active when:" Target="{Binding ElementName=MatchTypeCombo}" />
            <ComboBox x:Name="MatchTypeCombo" Grid.Row="1" Grid.Column="1" Margin="0,2"
                      DisplayMemberPath="Value" SelectedValuePath="Key" />
            <Label Grid.Row="2" Content="_Value:" Target="{Binding ElementName=MatchValueBox}" />
            <TextBox x:Name="MatchValueBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
        </Grid>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Or pick an open window" Margin="0,16,0,4" />
        <ListView x:Name="WindowList" Height="180" SelectionChanged="WindowList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Program" DisplayMemberBinding="{Binding Exe}" Width="140" />
                    <GridViewColumn Header="Window title" DisplayMemberBinding="{Binding Title}" Width="320" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                   Text="Picking a window fills in the value for the selected 'Active when' option." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button IsDefault="True" Click="Ok_Click">OK</Button>
            <Button IsCancel="True" Margin="0">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
