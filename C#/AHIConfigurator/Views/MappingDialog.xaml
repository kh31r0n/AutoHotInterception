<Window x:Class="AHIConfigurator.Views.MappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapping" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="16">
        <!-- 1. Input -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="1. When I press..." />
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Content="_Device:" Target="{Binding ElementName=DeviceCombo}" />
            <ComboBox x:Name="DeviceCombo" Grid.Column="1" Margin="0,2" DisplayMemberPath="Name"
                      SelectionChanged="DeviceCombo_SelectionChanged" />
            <Label Grid.Row="1" Content="_Key/button:" Target="{Binding ElementName=TriggerCombo}" />
            <ComboBox x:Name="TriggerCombo" Grid.Row="1" Grid.Column="1" Margin="0,2"
                      DisplayMemberPath="Value" SelectedValuePath="Key" IsTextSearchEnabled="True" TextSearch.TextPath="Value" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="90,2,0,0">
            <Button x:Name="CaptureKeyButton" Click="CaptureKey_Click">⌨ Press a key...</Button>
            <Button x:Name="CaptureMouseButton" Click="CaptureMouse_Click">🖱 Press a mouse button...</Button>
            <Button x:Name="CancelCaptureButton" Click="CancelCapture_Click" Visibility="Collapsed">Cancel capture</Button>
        </StackPanel>
        <TextBlock x:Name="CaptureStatus" Style="{StaticResource Hint}" Margin="90,6,0,0"
                   Text="Tip: use the buttons above and press the key on the device you want to remap - the device is picked for you." />

        <!-- 2. Action -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="2. ...it does" Margin="0,18,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="_Action:" Target="{Binding ElementName=ActionCombo}" />
            <ComboBox x:Name="ActionCombo" Grid.Column="1" Margin="0,2" DisplayMemberPath="Value" SelectedValuePath="Key"
                      SelectionChanged="ActionCombo_SelectionChanged" />
        </Grid>

        <Grid Margin="90,8,0,0" MinHeight="70">
            <!-- Key -->
            <StackPanel x:Name="KeyPanel">
                <ComboBox x:Name="TargetKeyCombo" DisplayMemberPath="Value" SelectedValuePath="Key"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Value" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="CaptureTargetButton" Click="CaptureTarget_Click">⌨ Press the key to send...</Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="The key is held down for as long as you hold the original key or button." />
            </StackPanel>
            <!-- Mouse -->
            <StackPanel x:Name="MousePanel">
                <ComboBox x:Name="TargetMouseCombo" DisplayMemberPath="Value" SelectedValuePath="Key" />
            </StackPanel>
            <!-- Text -->
            <StackPanel x:Name="TextPanel">
                <TextBox x:Name="TextValue" AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Typed exactly as written, once per press." />
            </StackPanel>
            <!-- Send -->
            <StackPanel x:Name="SendPanel">
                <TextBox x:Name="SendValue" FontFamily="Consolas" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="CaptureSendButton" Click="CaptureSend_Click"
                            ToolTip="Hold Ctrl / Alt / Shift / Win and press a key, eg Ctrl+Shift+Esc">⌨ Press the key to send...</Button>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                    AutoHotkey Send syntax: ^ Ctrl, ! Alt, + Shift, # Win, {Enter}, {Tab}, {F5}...<LineBreak />
                    Examples: <Run FontFamily="Consolas">^c</Run> (copy), <Run FontFamily="Consolas">^+{Esc}</Run> (Task Manager).
                    <Hyperlink NavigateUri="https://www.autohotkey.com/docs/v2/lib/Send.htm" RequestNavigate="Hyperlink_RequestNavigate">More</Hyperlink>
                </TextBlock>
            </StackPanel>
            <!-- Run -->
            <StackPanel x:Name="RunPanel">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Click="BrowseRun_Click">Browse...</Button>
                    <TextBox x:Name="RunValue" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8" Text="A program, document, folder or web address. Arguments can follow the quoted program path." />
                <DockPanel>
                    <Label Content="Start in:" Padding="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="RunArgs" />
                </DockPanel>
            </StackPanel>
            <!-- Block / pass-through -->
            <TextBlock x:Name="BlockPanel" Style="{StaticResource Hint}"
                       Text="The key or button does nothing on this device. Other devices are not affected." />
            <TextBlock x:Name="PassThroughPanel" Style="{StaticResource Hint}"
                       Text="The key or button keeps its normal function. Use this in an app profile to switch off a Default mapping for that app." />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" IsDefault="True" Click="Ok_Click">OK</Button>
            <Button IsCancel="True" Margin="0">Cancel</Button>
        </StackPanel>
    </StackPanel>
</Window>
