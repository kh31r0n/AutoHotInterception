<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>AutoHotInterception</RootNamespace>
    <AssemblyName>AutoHotInterception</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="ToDo.md" />
    <!-- interception.dll is loaded at runtime from <assembly dir>\x86|x64 (see Helpers\ManagedWrapper.cs).
         CopyToOutputDirectory also flows to projects that reference this one. -->
    <None Include="..\Dependencies\x86\interception.dll" Link="x86\interception.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Dependencies\x86\interception.dll')" />
    <None Include="..\Dependencies\x64\interception.dll" Link="x64\interception.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\Dependencies\x64\interception.dll')" />
  </ItemGroup>
  <Target Name="WarnMissingInterception" BeforeTargets="Build" Condition="!Exists('..\Dependencies\x86\interception.dll') Or !Exists('..\Dependencies\x64\interception.dll')">
    <Warning Text="interception.dll not found in C#\Dependencies\x86 and/or x64. See C#\Dependencies\Readme.md." />
  </Target>
  <Target Name="CopyToLib" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\..\Lib" SkipUnchangedFiles="true" />
  </Target>
</Project>
