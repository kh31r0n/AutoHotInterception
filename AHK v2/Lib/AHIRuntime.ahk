/*
Runtime for scripts generated by the AHI Configurator.
The generated script only holds data (devices + profiles + mappings) and calls AHIRuntime.Start(config).
All behaviour lives here, so generated scripts stay simple and predictable.

Config format (AHK Maps / Arrays):
	Map(
		"devices", [Map("key", "kb1", "name", "...", "isMouse", 0, "handle", "HID\VID_...", "vid", 0x046D, "pid", 0xC31C, "instance", 1), ...],
		"profiles", [Map("name", "Photoshop", "match", "ahk_exe Photoshop.exe", "mappings", [...]), ..., Map("name", "Default", "match", "", "mappings", [...])],
		"configurator", "C:\...\AHIConfigurator.exe"	; optional, used by the tray menu
	)
Mapping:
	Map("dev", "kb1", "input", "key"|"mouse", "code", <code>, "action", <action>, "value", <value>, "args", "")
	key codes are AHK scan codes (as returned by GetKeySC, extended keys are + 0x100)
	mouse codes: 0 LButton, 1 RButton, 2 MButton, 3 XButton1, 4 XButton2, 5 WheelUp, 6 WheelDown, 7 WheelRight, 8 WheelLeft
	actions:
		"key"      value = scan code to send
		"mouse"    value = mouse code to send
		"block"    input is swallowed
		"passthru" input is sent unchanged (lets a profile override a mapping in a later profile)
		"text"     value = text to type (on press only)
		"send"     value = AHK Send string, eg "^c" or "{Home}+{End}" (on press only)
		"run"      value = program / document / URL, args = working directory (on press only)
Profiles are checked in order; the first active profile (empty match, or WinActive(match)) that has a mapping for an input wins.
If no profile maps an input, it is passed through unchanged.
*/
#Requires AutoHotkey v2.0
#include %A_LineFile%\..\AutoHotInterception.ahk

class AHIRuntime {
	static Current := ""
	static MouseNames := ["LButton", "RButton", "MButton", "XButton1", "XButton2", "WheelUp", "WheelDown", "WheelRight", "WheelLeft"]

	; Entry point used by generated scripts
	static Start(config, manager := "") {
		Persistent()
		AHIRuntime.Current := AHIRuntime(config, manager)
		AHIRuntime.Current.Run()
		return AHIRuntime.Current
	}

	; manager is the C# AutoHotInterception.Manager (or a stub with the same methods, for testing)
	__New(config, manager := "") {
		this.Config := config
		if (manager == "") {
			this.Wrapper := AutoHotInterception()
			manager := this.Wrapper.GetInstance()
		}
		this.AHI := manager
		this.DeviceIds := Map()		; device key -> AHI device ID
		this.Missing := []			; names of configured devices that are not connected
		this.Profiles := []			; {name, match, index: Map(triggerKey -> mapping)}
		this.Subscriptions := Map()	; "dev|input|subscribeCode" -> [dev, input, subscribeCode]
		this.Held := Map()			; triggerKey -> mapping that handled the press, so the release uses the same one
		this.Paused := false
	}

	Run() {
		this.ResolveDevices()
		this.BuildIndex()
		this.Subscribe()
		this.BuildTrayMenu()
		if (this.Missing.Length) {
			names := ""
			for name in this.Missing
				names .= (names = "" ? "" : ", ") name
			this.Notify("Not connected: " names ". Their mappings are inactive until you plug them in and click Apply in the Configurator (or remove them there with Forget).", "Iconi")
		}
	}

	ResolveDevices() {
		for dev in this.Config["devices"] {
			isMouse := dev["isMouse"] ? true : false
			id := 0
			if (dev.Has("handle") && dev["handle"] != "")
				id := this.AHI.GetDeviceIdFromHandle(isMouse, dev["handle"], dev["instance"])
			if (!id && dev.Has("vid") && dev["vid"] && dev["pid"])
				id := this.AHI.GetDeviceId(isMouse, dev["vid"], dev["pid"], dev["instance"])
			if (id)
				this.DeviceIds[dev["key"]] := id
			else
				this.Missing.Push(dev.Has("name") && dev["name"] != "" ? dev["name"] : dev["key"])
		}
	}

	BuildIndex() {
		for profile in this.Config["profiles"] {
			index := Map()
			for m in profile["mappings"] {
				if (!this.DeviceIds.Has(m["dev"]))
					continue
				index[AHIRuntime.TriggerKey(m["dev"], m["input"], m["code"])] := m
				subCode := AHIRuntime.SubscribeCode(m["input"], m["code"])
				this.Subscriptions[m["dev"] "|" m["input"] "|" subCode] := [m["dev"], m["input"], subCode]
			}
			this.Profiles.Push({name: profile["name"], match: profile["match"], index: index})
		}
	}

	Subscribe() {
		for , s in this.Subscriptions {
			id := this.DeviceIds[s[1]]
			if (s[2] = "key")
				this.AHI.SubscribeKey(id, s[3], true, this.OnKey.Bind(this, s[1], s[3]), false)
			else
				this.AHI.SubscribeMouseButton(id, s[3], true, this.OnMouseButton.Bind(this, s[1], s[3]), false)
		}
	}

	; ------------------------- Input handling -------------------------
	OnKey(dev, code, state) {
		this.OnInput(dev, "key", code, state)
	}

	; AHI reports both wheel directions on button 5 (vertical) / 6 (horizontal), with state = direction
	OnMouseButton(dev, btn, state) {
		if (btn = 5)
			this.OnInput(dev, "mouse", state > 0 ? 5 : 6, 1)
		else if (btn = 6)
			this.OnInput(dev, "mouse", state > 0 ? 7 : 8, 1)
		else
			this.OnInput(dev, "mouse", btn, state)
	}

	; state: 1 = press, 0 = release. Wheel notches only ever arrive as a press.
	OnInput(dev, input, code, state) {
		trigger := AHIRuntime.TriggerKey(dev, input, code)
		isWheel := AHIRuntime.IsWheel(input, code)
		isRepeat := false
		if (state && !isWheel) {
			isRepeat := this.Held.Has(trigger)
			if (!isRepeat)
				this.Held[trigger] := this.FindMapping(trigger)
			mapping := this.Held[trigger]
		} else if (!state && this.Held.Has(trigger)) {
			mapping := this.Held.Delete(trigger)
		} else {
			mapping := this.FindMapping(trigger)
		}
		try {
			this.Execute(dev, input, code, state, mapping, isWheel, isRepeat)
		} catch Error as e {
			this.Notify("Mapping failed: " e.Message)
		}
	}

	FindMapping(trigger) {
		for profile in this.Profiles {
			if (!profile.index.Has(trigger))
				continue
			if (profile.match = "" || this.IsWindowActive(profile.match))
				return profile.index[trigger]
		}
		return ""
	}

	Execute(dev, input, code, state, mapping, isWheel, isRepeat) {
		action := mapping == "" ? "passthru" : mapping["action"]
		switch action {
			case "passthru":
				this.SendSame(dev, input, code, state, isWheel)
			case "block":
				return
			case "key":
				if (input = "key")
					this.AHI.SendKeyEvent(this.DeviceIds[dev], mapping["value"], state)
				else
					this.SendAhk("{Blind}" AHIRuntime.ScKey(mapping["value"], state, isWheel))
			case "mouse":
				target := mapping["value"]
				if (AHIRuntime.IsWheel("mouse", target)) {
					; Holding a key scrolls repeatedly via auto-repeat
					if (state)
						this.SendAhk("{Blind}{" AHIRuntime.MouseNames[target + 1] "}")
				} else if (input = "mouse" && !isWheel)
					this.AHI.SendMouseButtonEvent(this.DeviceIds[dev], target, state)
				else if (!isRepeat)
					this.SendAhk("{Blind}" AHIRuntime.MouseKey(target, state, isWheel))
			case "text":
				if (state && !isRepeat)
					this.SendText(mapping["value"])
			case "send":
				if (state && !isRepeat)
					this.SendAhk(mapping["value"])
			case "run":
				if (state && !isRepeat)
					this.RunTarget(mapping["value"], mapping.Has("args") ? mapping["args"] : "")
			default:
				throw ValueError("Unknown action: " action)
		}
	}

	SendSame(dev, input, code, state, isWheel) {
		id := this.DeviceIds[dev]
		if (input = "key")
			this.AHI.SendKeyEvent(id, code, state)
		else if (isWheel)
			this.AHI.SendMouseButtonEvent(id, code <= 6 ? 5 : 6, Mod(code, 2) ? 1 : -1)
		else
			this.AHI.SendMouseButtonEvent(id, code, state)
	}

	; Overridable side effects (the test harness replaces these)
	SendAhk(keys) {
		Send(keys)
	}

	SendText(text) {
		SendText(text)
	}

	RunTarget(target, workingDir) {
		Run(target, workingDir)
	}

	IsWindowActive(winTitle) {
		return WinActive(winTitle)
	}

	Notify(msg, icon := "Iconx") {
		TrayTip(msg, "AutoHotInterception", icon)
	}

	; ------------------------- Tray menu -------------------------
	BuildTrayMenu() {
		tray := A_TrayMenu
		tray.Delete()
		tray.Add("Pause mappings", (*) => this.TogglePause())
		if (this.Config.Has("configurator") && this.Config["configurator"] != "")
			tray.Add("Open Configurator", (*) => Run('"' this.Config["configurator"] '"'))
		tray.Add()
		tray.Add("Exit", (*) => ExitApp())
		A_IconTip := "AutoHotInterception mappings"
	}

	TogglePause() {
		this.Paused := !this.Paused
		this.AHI.SetState(!this.Paused)
		if (this.Paused)
			A_TrayMenu.Check("Pause mappings")
		else
			A_TrayMenu.Uncheck("Pause mappings")
	}

	; ------------------------- Helpers -------------------------
	static TriggerKey(dev, input, code) {
		return dev "|" input "|" code
	}

	static IsWheel(input, code) {
		return input = "mouse" && code >= 5
	}

	; Both wheel directions share one AHI subscription per axis
	static SubscribeCode(input, code) {
		if (!AHIRuntime.IsWheel(input, code))
			return code
		return code <= 6 ? 5 : 6
	}

	; Send string for a scan code. A wheel notch has no release, so it sends a full press + release.
	static ScKey(code, state, isWheel := false) {
		sc := Format("sc{:03X}", code)
		if (isWheel)
			return "{" sc "}"
		return "{" sc (state ? " down}" : " up}")
	}

	static MouseKey(code, state, isWheel := false) {
		name := AHIRuntime.MouseNames[code + 1]
		if (isWheel)
			return "{" name "}"
		return "{" name (state ? " down}" : " up}")
	}
}
